#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5c1f87662800 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5c1f87662990 .scope module, "tb" "tb" 3 3;
 .timescale -9 -12;
v0x5c1f8767f370_0 .var "clk", 0 0;
v0x5c1f8767f460_0 .net "data", 7 0, v0x5c1f8767edd0_0;  1 drivers
v0x5c1f8767f530_0 .var "data_expected", 7 0;
v0x5c1f8767f600_0 .var/i "errors", 31 0;
v0x5c1f8767f6e0_0 .var/i "i", 31 0;
v0x5c1f8767f810_0 .var "reset_n", 0 0;
v0x5c1f8767f8b0_0 .var/i "samples", 31 0;
S_0x5c1f87628490 .scope module, "lfsr_inst" "lfsr" 3 10, 4 1 0, S_0x5c1f87662990;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset_n";
    .port_info 2 /OUTPUT 8 "data";
v0x5c1f876286c0_0 .net "clk", 0 0, v0x5c1f8767f370_0;  1 drivers
v0x5c1f8767edd0_0 .var "data", 7 0;
v0x5c1f8767eeb0_0 .net "reset_n", 0 0, v0x5c1f8767f810_0;  1 drivers
E_0x5c1f8763c680/0 .event negedge, v0x5c1f8767eeb0_0;
E_0x5c1f8763c680/1 .event posedge, v0x5c1f876286c0_0;
E_0x5c1f8763c680 .event/or E_0x5c1f8763c680/0, E_0x5c1f8763c680/1;
S_0x5c1f8767efd0 .scope function.vec4.s8, "reference_lfsr_output" "reference_lfsr_output" 3 26, 3 26 0, S_0x5c1f87662990;
 .timescale -9 -12;
v0x5c1f8767f1b0_0 .var "current_state", 7 0;
; Variable reference_lfsr_output is vec4 return value of scope S_0x5c1f8767efd0
TD_tb.reference_lfsr_output ;
    %load/vec4 v0x5c1f8767f1b0_0;
    %parti/s 7, 0, 2;
    %load/vec4 v0x5c1f8767f1b0_0;
    %parti/s 1, 0, 2;
    %load/vec4 v0x5c1f8767f1b0_0;
    %parti/s 1, 3, 3;
    %xor;
    %load/vec4 v0x5c1f8767f1b0_0;
    %parti/s 1, 5, 4;
    %xor;
    %load/vec4 v0x5c1f8767f1b0_0;
    %parti/s 1, 6, 4;
    %xor;
    %concat/vec4; draw_concat_vec4
    %ret/vec4 0, 0, 8;  Assign to reference_lfsr_output (store_vec4_to_lval)
    %end;
    .scope S_0x5c1f87628490;
T_1 ;
    %wait E_0x5c1f8763c680;
    %load/vec4 v0x5c1f8767eeb0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 138, 0, 8;
    %assign/vec4 v0x5c1f8767edd0_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x5c1f8767edd0_0;
    %parti/s 7, 0, 2;
    %load/vec4 v0x5c1f8767edd0_0;
    %parti/s 1, 7, 4;
    %load/vec4 v0x5c1f8767edd0_0;
    %parti/s 1, 6, 4;
    %xor;
    %load/vec4 v0x5c1f8767edd0_0;
    %parti/s 1, 4, 4;
    %xor;
    %load/vec4 v0x5c1f8767edd0_0;
    %parti/s 1, 1, 2;
    %xor;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x5c1f8767edd0_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x5c1f87662990;
T_2 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5c1f8767f600_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5c1f8767f8b0_0, 0, 32;
    %end;
    .thread T_2, $init;
    .scope S_0x5c1f87662990;
T_3 ;
    %delay 5000, 0;
    %load/vec4 v0x5c1f8767f370_0;
    %inv;
    %store/vec4 v0x5c1f8767f370_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x5c1f87662990;
T_4 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c1f8767f370_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c1f8767f810_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5c1f8767f810_0, 0, 1;
    %load/vec4 v0x5c1f8767f8b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5c1f8767f8b0_0, 0, 32;
    %load/vec4 v0x5c1f8767f460_0;
    %cmpi/ne 138, 0, 8;
    %jmp/0xz  T_4.0, 6;
    %vpi_call/w 3 45 "$display", "Error: At time %t, data = %b, expected = 10001010", $time, v0x5c1f8767f460_0 {0 0 0};
    %load/vec4 v0x5c1f8767f600_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5c1f8767f600_0, 0, 32;
T_4.0 ;
    %pushi/vec4 138, 0, 8;
    %store/vec4 v0x5c1f8767f530_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5c1f8767f6e0_0, 0, 32;
T_4.2 ;
    %load/vec4 v0x5c1f8767f6e0_0;
    %cmpi/s 256, 0, 32;
    %jmp/0xz T_4.3, 5;
    %load/vec4 v0x5c1f8767f530_0;
    %store/vec4 v0x5c1f8767f1b0_0, 0, 8;
    %callf/vec4 TD_tb.reference_lfsr_output, S_0x5c1f8767efd0;
    %store/vec4 v0x5c1f8767f530_0, 0, 8;
    %delay 10000, 0;
    %load/vec4 v0x5c1f8767f8b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5c1f8767f8b0_0, 0, 32;
    %load/vec4 v0x5c1f8767f460_0;
    %load/vec4 v0x5c1f8767f530_0;
    %cmp/ne;
    %jmp/0xz  T_4.4, 6;
    %vpi_call/w 3 63 "$display", "Error: At time %t, data = %b, expected = %b", $time, v0x5c1f8767f460_0, v0x5c1f8767f530_0 {0 0 0};
    %load/vec4 v0x5c1f8767f600_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5c1f8767f600_0, 0, 32;
T_4.4 ;
    %load/vec4 v0x5c1f8767f6e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5c1f8767f6e0_0, 0, 32;
    %jmp T_4.2;
T_4.3 ;
    %load/vec4 v0x5c1f8767f600_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_4.6, 4;
    %vpi_call/w 3 69 "$display", "Simulation successful. All test cases passed." {0 0 0};
T_4.6 ;
    %vpi_call/w 3 70 "$finish" {0 0 0};
    %end;
    .thread T_4;
    .scope S_0x5c1f87662990;
T_5 ;
    %vpi_call/w 3 73 "$display", "Mismatches: %1d in %1d samples", v0x5c1f8767f600_0, v0x5c1f8767f8b0_0 {0 0 0};
    %end;
    .thread T_5, $final;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "./lfsr_tb.sv";
    "outputs_lfsr/iter0/response0/lfsr.sv";
