#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x575c992e5900 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x575c992e5a90 .scope module, "tb" "tb" 3 3;
 .timescale -9 -12;
v0x575c992fe630_0 .net "bcd_output", 7 0, v0x575c992ab670_0;  1 drivers
v0x575c992fe720_0 .var "binary_input", 4 0;
v0x575c992fe7f0_0 .var/i "errors", 31 0;
v0x575c992fe8c0_0 .var "expected_bcd", 7 0;
v0x575c992fe9a0_0 .var/i "i", 31 0;
v0x575c992fead0_0 .var/i "samples", 31 0;
v0x575c992febb0_0 .var "test_binary", 4 0;
v0x575c992fec90_0 .var "vcd_clk", 0 0;
S_0x575c992ab490 .scope module, "uut" "binary_to_bcd_converter" 3 8, 4 1 0, S_0x575c992e5a90;
 .timescale 0 0;
    .port_info 0 /INPUT 5 "binary_input";
    .port_info 1 /OUTPUT 8 "bcd_output";
v0x575c992ab670_0 .var "bcd_output", 7 0;
v0x575c992fe350_0 .net "binary_input", 4 0, v0x575c992fe720_0;  1 drivers
v0x575c992fe430_0 .var "ones", 3 0;
v0x575c992fe4f0_0 .var "tens", 3 0;
E_0x575c992e4d60 .event anyedge, v0x575c992fe350_0, v0x575c992fe4f0_0, v0x575c992fe430_0;
    .scope S_0x575c992ab490;
T_0 ;
    %wait E_0x575c992e4d60;
    %load/vec4 v0x575c992fe350_0;
    %pushi/vec4 10, 0, 5;
    %div;
    %pad/u 4;
    %store/vec4 v0x575c992fe4f0_0, 0, 4;
    %load/vec4 v0x575c992fe350_0;
    %pushi/vec4 10, 0, 5;
    %mod;
    %pad/u 4;
    %store/vec4 v0x575c992fe430_0, 0, 4;
    %load/vec4 v0x575c992fe4f0_0;
    %load/vec4 v0x575c992fe430_0;
    %concat/vec4; draw_concat_vec4
    %store/vec4 v0x575c992ab670_0, 0, 8;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x575c992e5a90;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x575c992fe7f0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x575c992fead0_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x575c992e5a90;
T_2 ;
    %vpi_call/w 3 19 "$display", "Testing Binary-to-BCD Converter..." {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x575c992fe9a0_0, 0, 32;
T_2.0 ;
    %load/vec4 v0x575c992fe9a0_0;
    %cmpi/s 32, 0, 32;
    %jmp/0xz T_2.1, 5;
    %load/vec4 v0x575c992fe9a0_0;
    %pad/s 5;
    %store/vec4 v0x575c992febb0_0, 0, 5;
    %load/vec4 v0x575c992febb0_0;
    %store/vec4 v0x575c992fe720_0, 0, 5;
    %load/vec4 v0x575c992febb0_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %mod;
    %pad/u 4;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x575c992fe8c0_0, 4, 4;
    %load/vec4 v0x575c992febb0_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %div;
    %pad/u 4;
    %ix/load 4, 4, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x575c992fe8c0_0, 4, 4;
    %delay 10000, 0;
    %load/vec4 v0x575c992fead0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x575c992fead0_0, 0, 32;
    %load/vec4 v0x575c992fe630_0;
    %load/vec4 v0x575c992fe8c0_0;
    %cmp/ne;
    %jmp/0xz  T_2.2, 6;
    %vpi_call/w 3 33 "$display", "Error: Test case %0d failed. Expected BCD: 8'b%0b, Got: 8'b%0b", v0x575c992febb0_0, v0x575c992fe8c0_0, v0x575c992fe630_0 {0 0 0};
    %load/vec4 v0x575c992fe7f0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x575c992fe7f0_0, 0, 32;
T_2.2 ;
    ; show_stmt_assign_vector: Get l-value for compressed += operand
    %load/vec4 v0x575c992fe9a0_0;
    %pushi/vec4 1, 0, 32;
    %add;
    %store/vec4 v0x575c992fe9a0_0, 0, 32;
    %jmp T_2.0;
T_2.1 ;
    %load/vec4 v0x575c992fe7f0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.4, 4;
    %vpi_call/w 3 39 "$display", "All test cases passed!" {0 0 0};
T_2.4 ;
    %vpi_call/w 3 40 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x575c992e5a90;
T_3 ;
    %vpi_call/w 3 43 "$display", "Mismatches: %1d in %1d samples", v0x575c992fe7f0_0, v0x575c992fead0_0 {0 0 0};
    %end;
    .thread T_3, $final;
    .scope S_0x575c992e5a90;
T_4 ;
    %vpi_call/w 3 47 "$dumpfile", "my_design.vcd" {0 0 0};
    %vpi_call/w 3 48 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x575c992e5a90 {0 0 0};
    %end;
    .thread T_4;
    .scope S_0x575c992e5a90;
T_5 ;
    %delay 5000, 0;
    %load/vec4 v0x575c992fec90_0;
    %inv;
    %store/vec4 v0x575c992fec90_0, 0, 1;
    %jmp T_5;
    .thread T_5;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "./binary_to_bcd_tb.sv";
    "outputs_binary_to_bcd/iter0/response0/binary_to_bcd_converter.sv";
